#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# The first ndo_open() of a PON line after boot can leave the EPON MAC in an
# LLID epoch the OLT never grants upstream slots for: a dark module still wins
# an LLID and loses the grant about one second later.
#
# The driver owns recovery. Its link_work watchdog, MPCP timeout ladder and
# reopen_work perform a real dev_close()/dev_open() (controller_stop() runs
# synchronize_irq() before taking state_lock, which link_work cannot do), and
# the frontend re-prepare is what actually relights a cold EN7572.
#
# Carrier no longer follows each LLID grant: the stable-registration fix only
# raises it after the LLID survives 2 s, so dead LLIDs produce no carrier edge
# at all. carrier=0 therefore cannot be read as a flap - during a cold boot it
# usually just means the kernel is still recovering. A down/up from here calls
# controller_start(), which clears the driver's queued re-open, so only
# intervene on a genuine flap (carrier rose, then fell), or once, very late,
# as a last resort.

. /lib/functions.sh

LOG_TAG=pon-reopen
SETTLE_SECONDS=3
# Long enough for the driver's 5 s dark watchdog plus its 5 s / 30 s re-open
# backoffs and one frontend re-prepare. A shorter window made this script
# down/up the line twice while the kernel was still relighting the module.
CARRIER_WAIT_SECONDS=90
# A real flap is observed immediately after a re-open; no need to wait the
# full cold-boot recovery window again on every attempt.
REOPEN_WAIT_SECONDS=30
VERIFY_SECONDS=12
MAX_ATTEMPTS=2

log() {
	logger -t "$LOG_TAG" "$*"
}

# Returns 0 only if the carrier still reads 1 on every sample.
carrier_stable() {
	local device="$1"
	local index=0

	while [ "$index" -lt "$VERIFY_SECONDS" ]; do
		[ "$(cat "/sys/class/net/$device/carrier" 2>/dev/null)" = "1" ] ||
			return 1
		sleep 1
		index=$((index + 1))
	done

	return 0
}

# Waits for a registration stable enough to raise carrier. Returns 1 when the
# line never came up - that is a pending recovery, not a flap.
wait_for_carrier() {
	local device="$1"
	local wait_seconds="${2:-$CARRIER_WAIT_SECONDS}"
	local deadline=$(( $(date +%s) + wait_seconds ))

	while [ "$(date +%s)" -lt "$deadline" ]; do
		[ "$(cat "/sys/class/net/$device/carrier" 2>/dev/null)" = "1" ] &&
			return 0
		sleep 1
	done

	return 1
}

wait_for_line_up() {
	local device="$1"
	local deadline=$(( $(date +%s) + 90 ))
	local flags

	while [ "$(date +%s)" -lt "$deadline" ]; do
		flags=$(cat "/sys/class/net/$device/flags" 2>/dev/null)
		# A line netifd keeps administratively down is not ours to raise.
		if [ -n "$flags" ] && [ $((flags & 1)) -eq 1 ]; then
			return 0
		fi
		sleep 1
	done

	return 1
}

reopen_line() {
	local device="$1"

	ip link set dev "$device" down || return 1
	sleep 1
	ip link set dev "$device" up || return 1
}

reopen_section() {
	local section="$1"
	local device enabled attempt=0

	config_get device "$section" device
	config_get_bool enabled "$section" reopen_on_boot 1

	[ -n "$device" ] || return 0
	[ "$enabled" -eq 1 ] || {
		log "$device: boot re-open is disabled"
		return 0
	}
	wait_for_line_up "$device" || {
		log "$device: never came up, leaving it alone"
		return 0
	}

	sleep "$SETTLE_SECONDS"
	if ! wait_for_carrier "$device"; then
		# No carrier edge at all means dead LLIDs or a still-dark module,
		# not a flap. One late re-open is a last-resort re-prepare; doing it
		# early would cancel the driver's queued re-open and restart the
		# epoch it was about to fix.
		log "$device: no stable carrier after ${CARRIER_WAIT_SECONDS}s; one last-resort re-open, then leaving the kernel to recover"
		reopen_line "$device" || log "$device: last-resort re-open failed"
		return 0
	fi
	if carrier_stable "$device"; then
		log "$device: carrier is stable, leaving the first open alone"
		return 0
	fi

	# Carrier rose and fell again: this is the real flap the service exists
	# to break.
	while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
		attempt=$((attempt + 1))
		log "$device: carrier is flapping, re-opening the line (attempt $attempt)"
		reopen_line "$device" || log "$device: re-opening the line failed"
		if ! wait_for_carrier "$device" "$REOPEN_WAIT_SECONDS"; then
			log "$device: no stable carrier after attempt $attempt; leaving the kernel to recover"
			return 0
		fi
		if carrier_stable "$device"; then
			log "$device: line is stable after re-opening"
			return 0
		fi
	done

	log "$device: line still flapping after $MAX_ATTEMPTS re-opens"
}

main() {
	config_load pon
	config_foreach reopen_section xpon
}

main "$@"
