#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Runs after network (START=20) and the OAM/OMCI agent (START=19), so the line
# has already been opened once by netifd. See /usr/libexec/pon-reopen for why
# that first open sometimes needs to be repeated.

START=95
STOP=05
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/pon-reopen
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
