config xpon 'line0'
	option device 'pon0'
	option mode ''
	# Colon-separated unicast MAC; empty leaves the interface MAC untouched.
	option macaddr ''
	# Accepts 16 raw hex digits or VEND followed by 8 hex digits.
	option serial_number ''
	# Accepts text:VALUE or hex: followed by 72 hex digits.
	option registration_id ''
	# Re-open the line once after boot when it never stops flapping: the first
	# open can leave the EPON MAC in an LLID epoch the OLT never grants.
	option reopen_on_boot '1'

config omci 'line0_omci'
	option line 'line0'
	option device 'omci0'
	option omcc_version '0xb0'
	option disable_enhanced_security '0'

	option vendor_id ''
	option equipment_id ''
	option hardware_version ''
	option software_version ''
	option operator_id ''
	option loid ''
	# 0x00 fill side of the 24-byte LOID field: leading (right aligned) or
	# trailing (left aligned).
	option loid_padding 'trailing'
	option loid_password ''

config oam 'line0_oam'
	option line 'line0'
	option device 'oam0'
	# ieee selects 802.3ah; ctc enables CTC extensions.
	option operator 'ctc'
	option ctc_oui '111111'
	option ctc_versions '21 30'

	option vendor_id ''
	option model ''
	option equipment_id ''
	option hardware_version ''
	option software_version ''
	option firmware_version ''
	# 8-byte wire-order value encoded as 16 hex digits.
	option chipset_id ''
	option loid ''
	# 0x00 fill side of the 24-byte LOID field: leading (right aligned) or
	# trailing (left aligned).
	option loid_padding 'leading'
	option loid_password ''
	option ge_ports '1'
